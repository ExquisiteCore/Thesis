<Window x:Class="Thesis.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thesis · 论文工作台">
  <Grid x:Name="Root" Background="{ThemeResource ThesisCanvasBrush}" KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewShortcut_Invoked" />
      <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenShortcut_Invoked" />
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveShortcut_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Padding="20,8" ColumnSpacing="20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource ThesisAccentBrush}"><FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="White"/></Border>
        <StackPanel><TextBlock Text="Thesis" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="论文工作台" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </StackPanel>
      <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsDynamicOverflowEnabled="True">
        <AppBarButton Label="新建" Icon="Add" Click="New_Click" IsEnabled="{Binding IsIdle}" ToolTipService.ToolTip="新建论文项目 (Ctrl+N)" />
        <AppBarButton Label="打开" Icon="OpenFile" Click="Open_Click" IsEnabled="{Binding IsIdle}" ToolTipService.ToolTip="打开论文项目 (Ctrl+O)" />
        <AppBarButton Label="保存" Icon="Save" Click="Save_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="保存当前项目 (Ctrl+S)" />
        <AppBarSeparator />
        <AppBarButton Label="导入正文" Icon="Import" Click="Import_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="从 Word 或正文文件导入内容" />
        <AppBarButton Label="生成 DOCX" Icon="Download" Click="Compose_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="按当前模板生成论文候选 DOCX" />
        <AppBarButton Label="导出 PDF" Icon="View" Click="Preview_Click" IsEnabled="{Binding CanEdit}" Foreground="{ThemeResource ThesisActionBrush}" ToolTipService.ToolTip="使用 WPS / Word 更新分页并导出 PDF" />
        <CommandBar.SecondaryCommands>
          <AppBarButton Label="另存项目副本" Icon="SaveLocal" Click="SaveCopy_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="将当前内容保存为独立项目副本" />
          <AppBarButton Label="导出 Markdown" Icon="Download" Click="ExportMarkdown_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="导出 Markdown" />
          <AppBarButton Label="导出项目包" Icon="Folder" Click="ExportPackage_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="导出项目包" />
          <AppBarButton Label="导入项目包" Icon="Import" Click="ImportPackage_Click" IsEnabled="{Binding IsIdle}" ToolTipService.ToolTip="导入项目包" />
          <AppBarButton Label="查找内容" Icon="Find" Click="Find_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="查找内容" />
          <AppBarButton Label="切换主题" Icon="Switch" Click="Theme_Click" ToolTipService.ToolTip="切换主题" />
          <AppBarButton Label="显示 / 隐藏属性" Icon="ShowResults" Click="Inspector_Click" ToolTipService.ToolTip="显示 / 隐藏属性" />
          <AppBarButton Label="环境诊断" Icon="Help" Click="Diagnostics_Click" ToolTipService.ToolTip="环境诊断" />
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Grid>
    <NavigationView x:Name="NavigationMenu" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="184" CompactPaneLength="48" ExpandedModeThresholdWidth="1400" CompactModeThresholdWidth="900" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" ItemInvoked="Navigation_Invoked">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="首页" Tag="home" Icon="Home"/>
        <NavigationViewItemSeparator/>
        <NavigationViewItem Content="写作" Tag="write" Icon="Edit" IsEnabled="{Binding HasProject}"/>
        <NavigationViewItem Content="模板" Tag="template" Icon="Page" IsEnabled="{Binding HasProject}"/>
        <NavigationViewItem Content="快速预览" Tag="preview" Icon="View" IsEnabled="{Binding HasProject}"/>
        <NavigationViewItem Content="检查" Tag="checks" Icon="Accept" IsEnabled="{Binding HasProject}"/>
        <NavigationViewItem Content="历史" Tag="history" Icon="Clock" IsEnabled="{Binding HasProject}"/>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="切换外观" Tag="theme" SelectsOnInvoked="False"><NavigationViewItem.Icon><FontIcon Glyph="&#xE706;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Grid Background="{ThemeResource ThesisCanvasBrush}" CornerRadius="10,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="PageHeader" Padding="28,20,28,16" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4"><TextBlock x:Name="PageHeading" Text="首页" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="开始新的论文，或继续上次的写作。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding ProjectLabel}" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <InfoBar x:Name="OperationError" Grid.Row="1" Margin="24,0,24,12" Severity="Error" Title="操作未完成" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=TwoWay}" IsClosable="True"/>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" MinWidth="340" /><ColumnDefinition x:Name="LivePreviewColumn" Width="0" /><ColumnDefinition x:Name="InspectorColumn" Width="280" /></Grid.ColumnDefinitions>
      <Grid Padding="16,22,12,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="论文大纲" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="8,0,0,16" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
          <Button Content="＋ 章节" Click="AddChapter_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="新增章节" />
          <Button Content="＋ 小节" Click="AddSection_Click" IsEnabled="{Binding CanEdit}" ToolTipService.ToolTip="在当前章新增小节" />
        </StackPanel>
        <ListView x:Name="OutlineList" Grid.Row="2" ItemsSource="{Binding Outline}" DisplayMemberPath="Label" SelectionChanged="Outline_SelectionChanged" SelectionMode="Single" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="论文大纲" />
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="上移" Click="MoveUp_Click" IsEnabled="{Binding CanDelete}" />
          <Button Content="下移" Click="MoveDown_Click" IsEnabled="{Binding CanDelete}" />
          <Button Content="删除" Click="Delete_Click" IsEnabled="{Binding CanDelete}" />
        </StackPanel>
          <Button Content="恢复上次大纲快照" Click="UndoStructure_Click" IsEnabled="{Binding CanUndo}" />
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Padding="28,16,28,24" RowSpacing="12" MaxWidth="960" HorizontalAlignment="Stretch" Background="{ThemeResource ThesisCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="4" Height="20" CornerRadius="2" Background="{ThemeResource ThesisAccentBrush}"/><TextBlock Text="写作" FontWeight="SemiBold"/><TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="当前章节" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="{Binding CharacterCount}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ToggleButton x:Name="LivePreviewToggle" Content="分屏预览" Checked="LivePreview_Changed" Unchecked="LivePreview_Changed" ToolTipService.ToolTip="在右侧实时查看正文"/></StackPanel>
        </Grid>
        <TextBox Grid.Row="1" Text="{Binding Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding HeadingReadOnly}" FontSize="26" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0,6" PlaceholderText="章节标题" LostFocus="Heading_LostFocus" AutomationProperties.Name="章节标题" />
        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <ComboBox x:Name="EditorBlockStyle" SelectedIndex="0" Width="112" ToolTipService.ToolTip="段落样式" SelectionChanged="EditorBlockStyle_Changed"><ComboBoxItem Content="正文" Tag="normal"/><ComboBoxItem Content="标题 1" Tag="heading1"/><ComboBoxItem Content="标题 2" Tag="heading2"/><ComboBoxItem Content="标题 3" Tag="heading3"/></ComboBox>
              <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource ThesisRuleBrush}" VerticalAlignment="Center"/>
              <Button x:Name="UndoEditorButton" Click="UndoEditor_Click" Style="{StaticResource ThesisEditorToolButtonStyle}" ToolTipService.ToolTip="撤销 (Ctrl+Z)" AutomationProperties.Name="撤销"><FontIcon Glyph="&#xE7A7;" FontSize="16"/></Button>
              <Button x:Name="RedoEditorButton" Click="RedoEditor_Click" Style="{StaticResource ThesisEditorToolButtonStyle}" ToolTipService.ToolTip="重做 (Ctrl+Y)" AutomationProperties.Name="重做"><FontIcon Glyph="&#xE7A6;" FontSize="16"/></Button>
              <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource ThesisRuleBrush}" VerticalAlignment="Center"/>
              <ToggleButton x:Name="FormatBoldButton" Content="B" FontWeight="Bold" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatBold_Click" ToolTipService.ToolTip="加粗 (Ctrl+B)" AutomationProperties.Name="加粗"/>
              <ToggleButton x:Name="FormatItalicButton" Content="I" FontStyle="Italic" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatItalic_Click" ToolTipService.ToolTip="斜体 (Ctrl+I)" AutomationProperties.Name="斜体"/>
              <ToggleButton x:Name="FormatUnderlineButton" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatUnderline_Click" ToolTipService.ToolTip="下划线" AutomationProperties.Name="下划线"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
              <ToggleButton x:Name="FormatStrikeButton" Content="S" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatStrike_Click" ToolTipService.ToolTip="删除线" AutomationProperties.Name="删除线"/>
              <ToggleButton x:Name="FormatSuperscriptButton" Content="x²" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatSuperscript_Click" ToolTipService.ToolTip="上标" AutomationProperties.Name="上标"/>
              <ToggleButton x:Name="FormatSubscriptButton" Content="x₂" Style="{StaticResource ThesisEditorToggleButtonStyle}" IsThreeState="True" Click="FormatSubscript_Click" ToolTipService.ToolTip="下标" AutomationProperties.Name="下标"/>
              <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource ThesisRuleBrush}" VerticalAlignment="Center"/>
              <ToggleButton x:Name="BulletListButton" Content="•" FontSize="18" Style="{StaticResource ThesisEditorToggleButtonStyle}" Click="BulletList_Click" ToolTipService.ToolTip="项目符号列表" AutomationProperties.Name="项目符号列表"/>
              <ToggleButton x:Name="NumberedListButton" Content="1." Style="{StaticResource ThesisEditorToggleButtonStyle}" Click="NumberedList_Click" ToolTipService.ToolTip="编号列表" AutomationProperties.Name="编号列表"/>
              <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource ThesisRuleBrush}" VerticalAlignment="Center"/>
              <Button x:Name="InsertObjectButton" Content="插入" Foreground="{ThemeResource ThesisActionBrush}" Style="{StaticResource ThesisEditorToolButtonStyle}" ToolTipService.ToolTip="插入图片、表格或公式">
                <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="图片" Click="InsertImage_Click"/><MenuFlyoutItem Text="表格" Click="InsertTable_Click"/><MenuFlyoutItem Text="公式 · LaTeX" Click="InsertEquation_Click"/></MenuFlyout></Button.Flyout>
              </Button>
            </StackPanel>
          </ScrollViewer>
          <Button x:Name="SourceModeButton" Grid.Column="1" Content="Markdown" Click="SourceMode_Click" Style="{StaticResource ThesisEditorToolButtonStyle}" ToolTipService.ToolTip="Markdown 导入 / 导出视图" AutomationProperties.Name="打开 Markdown 视图" Visibility="Collapsed"/>
        </Grid>
        <TextBlock x:Name="EditorModeNote" Grid.Row="3" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        <Grid Grid.Row="4">
          <Border Background="{ThemeResource ThesisPaperBrush}" BorderBrush="{ThemeResource ThesisRuleBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
              <RichEditBox x:Name="BodyEditor" TextChanged="BodyEditor_TextChanged" SelectionChanged="BodyEditor_SelectionChanged" IsReadOnly="{Binding BodyReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="17" Padding="48,38" BorderThickness="0" Background="Transparent" Foreground="{ThemeResource ThesisInkBrush}" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="当前章节富文本正文"/>
              <TextBox x:Name="SourceBodyEditor" TextChanged="SourceBody_TextChanged" Visibility="Collapsed" IsReadOnly="{Binding BodyReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="15" Padding="36,32" BorderThickness="0" Background="Transparent" Foreground="{ThemeResource ThesisInkBrush}" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="当前章节 Markdown 源码"/>
              <ScrollViewer x:Name="ObjectEditorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,26"><StackPanel x:Name="ObjectEditorPanel"/></ScrollViewer>
              <TextBlock x:Name="EditorPlaceholder" Text="从这里开始写。" IsHitTestVisible="False" Margin="56,46,48,40" Foreground="{ThemeResource ThesisMutedBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="18,16,18,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="实时预览" FontWeight="SemiBold"/><TextBlock Text="内容视图 · 非分页样式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel x:Name="LivePreviewBlocks" Spacing="14"/></ScrollViewer>
      </Grid>
      <ScrollViewer Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20,22" Spacing="16">
          <TextBlock Text="论文与模板" Style="{ThemeResource SubtitleTextBlockStyle}" />
          <StackPanel Spacing="12">
            <TextBox Header="论文题目" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" IsEnabled="{Binding CanEdit}" />
            <TextBox Header="作者" Text="{Binding Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
            <TextBox Header="中文关键词（分号分隔）" Text="{Binding Keywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" IsEnabled="{Binding CanEdit}" />
            <TextBox Header="英文关键词（分号分隔）" Text="{Binding KeywordsEnglish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" IsEnabled="{Binding CanEdit}" />
            <Button Content="将原稿章节转为 Markdown" Click="ConvertMarkdown_Click" IsEnabled="{Binding CanEdit}" />
            <Button Click="Template_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="选择 .docx 学校模板或合格论文"><TextBlock Text="{Binding TemplateLabel}" TextTrimming="CharacterEllipsis" /></Button>
            <Expander Header="套版与检查设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="初次使用保留自动识别的校准方案，确认后可载入已绑定方案。正文变更后请重新检查绑定关系。" TextWrapping="Wrap" FontSize="12" />
                <Button Click="Plan_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch"><TextBlock Text="{Binding PlanLabel}" TextTrimming="CharacterEllipsis" /></Button>
                <Button Click="Render_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch"><TextBlock Text="{Binding RenderLabel}" TextTrimming="CharacterEllipsis" /></Button>
                <Button Content="配置 WPS / Word" Click="ConfigureRender_Click" IsEnabled="{Binding CanEdit}" />
                <Button Content="载入学校要求" Click="Rules_Click" IsEnabled="{Binding CanEdit}" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <TextBlock Text="检查与待确认事项" FontWeight="SemiBold" />
          <TextBlock Text="候选成品保留模板校准和人工检查状态。修改内容后，请重新生成预览。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" /></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="打开 Word" Click="OpenDocument_Click" />
            <Button Content="打开 PDF" Click="OpenPdf_Click" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="HomePanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource ThesisCanvasBrush}">
      <StackPanel Width="1040" MaxWidth="{Binding ActualWidth, ElementName=HomePanel}" HorizontalAlignment="Left" Padding="32,24,32,32" Spacing="24">
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="项目" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="新建论文，或继续最近的写作。" FontSize="13" Foreground="{ThemeResource ThesisMutedBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="新建论文" Click="New_Click" Style="{StaticResource ThesisPrimaryButtonStyle}" Padding="18,9"/>
            <Button Content="打开项目" Click="Open_Click" Padding="16,9"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{ThemeResource ThesisRuleBrush}"/>
        <StackPanel Spacing="10">
          <TextBlock Text="最近打开" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="RecentEmpty" Text="暂无最近项目" TextWrapping="Wrap" Foreground="{ThemeResource ThesisMutedBrush}"/>
          <ListView ItemsSource="{Binding Recent}" IsItemClickEnabled="True" ItemClick="Recent_Click" SelectionMode="None" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate><DataTemplate><Grid Padding="14,12" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="6" Background="{ThemeResource ThesisAccentSoftBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource ThesisAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ThesisMutedBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="TemplatePanel" Grid.Row="2" Padding="24" ColumnSpacing="24" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="模板工作台" Style="{ThemeResource SubtitleTextBlockStyle}"/>
        <StackPanel Grid.Row="1" Spacing="8"><Button Content="导入学校模板 / 合格论文" Click="ImportTemplate_Click"/><Button Content="使用通用模板" Click="DefaultTemplate_Click"/><Button Content="从模板库选择" Click="Library_Click"/><Button Content="查看原模板" Click="TemplatePreview_Click"/></StackPanel>
        <ListView x:Name="RoleList" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="Role_SelectionChanged"/>
      </Grid>
      <Grid Grid.Column="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer><StackPanel Spacing="16" Padding="0,0,12,24">
        <TextBox x:Name="DesignName" Header="模板名称"/>
        <TextBlock x:Name="RoleEvidence" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button Content="重新选择此角色的样本段落" Click="ChooseSample_Click"/>
        <CheckBox x:Name="RoleOverride" Content="覆盖该角色的字体和段落格式"/>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBox x:Name="RoleFont" Header="中文字体" TextChanged="RolePreview_Changed"/>
          <TextBox x:Name="RoleLatinFont" Grid.Column="1" Header="西文字体"/>
        </Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <NumberBox x:Name="RoleSize" Header="字号（磅）" Minimum="5" Maximum="72" ValueChanged="RoleNumber_Changed"/>
          <NumberBox x:Name="RoleLine" Grid.Column="1" Header="行距（倍）" Minimum="0.5" Maximum="5" SmallChange="0.1" ValueChanged="RoleNumber_Changed"/>
          <NumberBox x:Name="RoleIndent" Grid.Column="2" Header="首行（字符）" Minimum="0" Maximum="10"/>
        </Grid>
        <ComboBox x:Name="RoleAlign" Header="对齐" HorizontalAlignment="Stretch" SelectionChanged="RolePreview_Changed"><ComboBoxItem Content="左对齐" Tag="left"/><ComboBoxItem Content="居中" Tag="center"/><ComboBoxItem Content="右对齐" Tag="right"/><ComboBoxItem Content="两端对齐" Tag="both"/><ComboBoxItem Content="分散对齐" Tag="distribute"/></ComboBox>
        <CheckBox x:Name="RoleBold" Content="加粗" Checked="RolePreview_Changed" Unchecked="RolePreview_Changed"/>
        <CheckBox x:Name="RoleConfirmed" Content="我已核对该规则及其识别样本"/>
        <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="24"><TextBlock x:Name="RoleSample" Foreground="Black" TextWrapping="Wrap" Text="排版样例：论文的内容、结构与格式。"/></Border>
        <Expander Header="页面设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10"><CheckBox x:Name="ApplyMargins" Content="将以下页边距应用于所有节"/><NumberBox x:Name="MarginTop" Header="上（毫米）" Minimum="0" Maximum="80"/><NumberBox x:Name="MarginBottom" Header="下（毫米）" Minimum="0" Maximum="80"/><NumberBox x:Name="MarginLeft" Header="左（毫米）" Minimum="0" Maximum="80"/><NumberBox x:Name="MarginRight" Header="右（毫米）" Minimum="0" Maximum="80"/></StackPanel></Expander>
        <Expander Header="封面与学校要求" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14"><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="编辑封面字段" Click="CoverFields_Click"/><Button Content="编辑内容要求" Click="Requirements_Click"/></StackPanel><TextBlock Text="先核对正文和标题的字体、行距，再检查封面、目录与学校要求。格式调整后点击“保存并应用”。" TextWrapping="Wrap"/></StackPanel></Expander>
        <TextBlock x:Name="TemplateReviewSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Expander Header="查看识别详情" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="TemplateNotes" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Expander>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Padding="0,8,0,0"><Button Content="保存并应用" Click="SaveTemplate_Click" Style="{StaticResource ThesisPrimaryButtonStyle}"/><Button Content="保存到模板库" Click="SaveLibrary_Click"/></StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="PreviewPanel" Grid.Row="2" Padding="24" RowSpacing="12" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="刷新快速预览" Click="RefreshPreview_Click"/><CheckBox x:Name="PreviewCurrent" Content="只看当前章节" IsChecked="True" Checked="PreviewScope_Changed" Unchecked="PreviewScope_Changed"/><Button Content="查看已导出 PDF" Click="PdfPreview_Click"/><Button Content="上一段 / 页" Click="PreviewPrevious_Click"/><Button Content="下一段 / 页" Click="PreviewNext_Click"/><TextBlock x:Name="PreviewPosition" VerticalAlignment="Center"/><Slider x:Name="PreviewZoom" Width="150" Minimum="60" Maximum="150" Value="100" ValueChanged="PreviewZoom_Changed" AutomationProperties.Name="预览缩放"/></StackPanel></ScrollViewer>
      <TextBlock x:Name="PreviewNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"><Border x:Name="PreviewPaper" Width="794" HorizontalAlignment="Center" Background="White" Padding="60" Margin="0,8,0,24" CornerRadius="4"><StackPanel x:Name="PreviewBlocks" Spacing="14"/></Border></ScrollViewer>
    </Grid>
    <Grid x:Name="ChecksPanel" Grid.Row="2" Padding="32" RowSpacing="16" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Text="内容与模板预检" Style="{ThemeResource SubtitleTextBlockStyle}"/><Button Content="重新检查" Click="Check_Click" IsEnabled="{Binding CanEdit}"/></StackPanel>
      <Grid Grid.Row="1">
        <ListView x:Name="ChecksList" ItemsSource="{Binding Issues}" IsItemClickEnabled="True" ItemClick="Issue_Click" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="16" Spacing="8"><TextBlock Text="{Binding Title}" FontSize="18"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
        <StackPanel x:Name="ChecksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
          <ProgressRing x:Name="ChecksProgress" Width="28" Height="28" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center"/>
          <SymbolIcon x:Name="ChecksStatusIcon" Symbol="Accept" Visibility="Collapsed" HorizontalAlignment="Center"/>
          <TextBlock x:Name="ChecksEmptyTitle" FontSize="20" TextAlignment="Center"/>
          <TextBlock x:Name="ChecksEmptyDetail" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="HistoryPanel" Grid.Row="2" Padding="24" ColumnSpacing="20" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="版本与恢复" Style="{ThemeResource SubtitleTextBlockStyle}"/><Button Grid.Row="1" Content="恢复未保存记录" Click="Recover_Click" IsEnabled="{Binding HasRecovery}"/><ListView x:Name="VersionList" Grid.Row="2" ItemsSource="{Binding Versions}" SelectionChanged="Version_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding CreatedAt}"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button Grid.Row="3" Content="恢复选中版本" Click="RestoreVersion_Click"/></Grid>
      <TextBox x:Name="HistoryBefore" Grid.Column="1" Header="选中的历史内容" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/><TextBox x:Name="HistoryAfter" Grid.Column="2" Header="当前内容" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
      </Grid>
    </NavigationView>
    <Grid x:Name="StatusStrip" Grid.Row="2" Height="34" Padding="20,4" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ProgressRing x:Name="ProgressIndicator" Width="18" Height="18" IsActive="{Binding IsBusy}" />
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
      <Button x:Name="CancelTaskButton" Grid.Column="2" Content="取消" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" ToolTipService.ToolTip="取消当前操作" />
    </Grid>
  </Grid>
</Window>
